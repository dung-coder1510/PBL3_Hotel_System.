@using PBL3_Hotel_System.Helpers
@model IEnumerable<PBL3_Hotel_System.Models.Booking>
<table class="table-luxury">
    <thead>
        <tr>
            <th>Khách hàng</th>
            <th style="text-align: center;">Phòng</th>
            <th>Ngày đến</th>
            <th style="text-align: center;">Trạng thái</th>
            <th style="text-align: right;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <!-- Tên và SĐT Khách hàng -->
                    <td class="customer-info">
                        <strong>@(item.kh?.Hoten ?? "N/A")</strong>
                        <small><i class="fas fa-phone-alt" style="font-size: 0.7rem; color: var(--primary-color);"></i> @(item.kh?.sđt ?? "Không có SĐT")</small>
                    </td>
                            
                    <!-- Số phòng -->
                    <td style="text-align: center;">
                        <span style="font-weight: 700; color: var(--primary-color); font-size: 1.1rem;">#@item.SoPhong</span>
                    </td>
                            
                    <!-- Ngày Check-In -->
                    <td>
                        <span style="background: #f8f9fa; padding: 5px 10px; border-radius: 6px; font-size: 0.9rem;">
                            <i class="far fa-calendar-alt text-muted"></i> @item.CheckIn.ToString("dd/MM/yyyy")
                        </span>
                    </td>
                            
                    <!-- Trạng thái (Dùng logic gán class) -->
                    <td style="text-align: center;">
                        @{
                            var status = HotelStatusHelper.GetBookingStatus(item.TrangThaiDat);
                        }
                        <span class="badge-status @status.CssClass">@status.Text</span>
                    </td>
                            
                    <!-- Nút Xem chi tiết -->
                    <td style="text-align: right;">
                        <a href="javascript:void(0)" onclick="loadBookingDetail(@item.BookingID)" class="btn-action-view">
                            <i class="fas fa-eye"></i> Xem
                        </a>

                    </td>
                </tr>
            }
        }
        else
        {
            <!-- GIAO DIỆN TRỐNG (EMPTY STATE) ĐỈNH CAO -->
            <tr>
                <td colspan="5" style="text-align: center; padding: 4rem 2rem;">
                    <i class="fas fa-clipboard-list" style="font-size: 3rem; color: #e0e0e0; margin-bottom: 15px;"></i>
                    <h4 style="color: var(--text-main); margin-bottom: 5px;">Chưa có dữ liệu</h4>
                    <p style="color: var(--text-light); font-size: 0.9rem;">Hiện tại không có khách hàng nào đang chờ xử lý.</p>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.TotalPages > 1)
{
    <div style="display: flex; justify-content: center; margin-top: 20px;">
        <ul style="display: flex; list-style: none; padding: 0; margin: 0; gap: 8px;">
            
            @* Nút Previous *@
            @if (ViewBag.CurrentPage > 1)
            {
                <li><button class="btn-page" onclick="loadTableData(@(ViewBag.CurrentPage - 1))"><i class="fas fa-chevron-left"></i></button></li>
            }

            @* Vẽ số trang *@
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li>
                    <button class="btn-page @(i == ViewBag.CurrentPage ? "active" : "")" onclick="loadTableData(@i)">
                        @i
                    </button>
                </li>
            }

            @* Nút Next *@
            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li><button class="btn-page" onclick="loadTableData(@(ViewBag.CurrentPage + 1))"><i class="fas fa-chevron-right"></i></button></li>
            }
        </ul>
    </div>
}