@model PBL3_Hotel_System.Models.Room

<style>
    /* 1. TYPOGRAPHY & SPACING */
    .room-form-wrapper {
        font-family: var(--font-body);
        padding: 10px 20px;
    }
    
    .form-group {
        margin-bottom: 25px;
    }

    .form-label {
        display: block;
        font-size: 0.8rem;
        font-weight: 700;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    /* 2. HIỆU ỨNG INPUT LUXURY */
    .form-input-luxury {
        width: 100%;
        padding: 12px 18px;
        font-size: 1rem;
        font-family: var(--font-heading);
        color: var(--secondary-color);
        background: #fdfdfd;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        outline: none;
        transition: all 0.3s ease;
        box-shadow: inset 0 1px 3px rgba(0,0,0,0.02);
    }

    .form-input-luxury:focus {
        background: #fff;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.15); /* Quầng sáng vàng bao quanh */
    }

    /* Input khi bị khóa (Chỉ đọc) */
    .input-readonly {
        background: #f4f6f8;
        border-color: #eee;
        color: #999;
        cursor: not-allowed;
    }
    .input-readonly:focus { box-shadow: none; border-color: #eee; }

    /* 3. NÚT BẤM (ACTION BUTTONS) */
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        margin-top: 35px;
        padding-top: 20px;
        border-top: 1px solid #eee;
    }

    .btn-outline {
        background: transparent;
        color: #666;
        border: 1px solid #ccc;
        border-radius: 30px;
        padding: 10px 25px;
        font-weight: 600;
        transition: 0.3s;
    }
    .btn-outline:hover { background: #f4f6f8; color: #333; }

    .btn-gold {
        background: linear-gradient(135deg, #d4af37 0%, #b8860b 100%);
        color: white;
        border: none;
        border-radius: 30px;
        padding: 10px 35px;
        font-weight: 700;
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
        transition: 0.3s;
    }
    .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(212, 175, 55, 0.4); }
</style>

<div class="room-form-wrapper">
    <!-- TIÊU ĐỀ MODAL -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <h3 style="font-family: var(--font-heading); color: var(--secondary-color); margin: 0; font-size: 1.8rem;">
            <i class="fas @(ViewBag.IsEdit ? "fa-edit" : "fa-plus-circle") text-gold" style="margin-right: 8px;"></i> 
            @(ViewBag.IsEdit ? "Cập Nhật Phòng" : "Đăng Ký Phòng Mới")
        </h3>
        <button type="button" onclick="closeAdminModal()" style="background: none; border: none; font-size: 1.8rem; color: #aaa; cursor: pointer; transition: 0.3s;" onmouseover="this.style.color='#f44336'" onmouseout="this.style.color='#aaa'">&times;</button>
    </div>

    <!-- FORM DỮ LIỆU (AJAX) -->
    <form asp-action="SaveRoom" asp-controller="Admin" method="post" class="ajax-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="isEdit" value="@ViewBag.IsEdit.ToString().ToLower()" />

        <!-- LƯỚI BỐ TRÍ DỮ LIỆU (GRID 2 CỘT) -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0 25px;">
            
            <!-- SỐ PHÒNG (Chiếm toàn bộ dòng đầu) -->
            <div class="form-group" style="grid-column: 1 / -1;">
                <label class="form-label">
                    <i class="fas fa-door-closed" style="color: var(--primary-color);"></i> Số Phòng Định Danh
                </label>
                @if (ViewBag.IsEdit)
                {
                    <input asp-for="SoPhong" class="form-input-luxury input-readonly" readonly />
                }
                else
                {
                    <input asp-for="SoPhong" type="number" class="form-input-luxury" placeholder="VD: 101, 205, 301..." required autofocus />
                }
            </div>

            <!-- LOẠI PHÒNG -->
            <div class="form-group">
                <label class="form-label">Hạng Phòng (Loại)</label>
                <select asp-for="LoaiPhong" id="LoaiPhong" class="form-input-luxury" style="cursor: pointer;" required>
                    <option value="Standard">Standard (Tiêu chuẩn)</option>
                    <option value="Deluxe">Deluxe (Cao cấp)</option>
                    <option value="Suite">Suite (Thương gia)</option>
                </select>
            </div>

            <!-- SỨC CHỨA -->
            <div class="form-group">
                <label class="form-label">Sức Chứa (Tối đa 5 Người)</label>
                <div style="position: relative;">
                    <!-- ĐÃ FIX: max="5" -->
                    <input asp-for="Size" id="Size" type="number" min="1" max="5" class="form-input-luxury" required 
                                    onkeydown="return event.keyCode !== 69 && event.keyCode !== 190 && event.keyCode !== 188 && event.keyCode !== 109 && event.keyCode !== 107" />
                    <i class="fas fa-user-friends" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: #ccc;"></i>
                </div>
            </div>

     
            <!-- GIÁ PHÒNG (READONLY) -->
                <div class="form-group" style="grid-column: 1 / -1; background: #ebfbee; padding: 15px 20px; border-radius: 8px; border-left: 4px solid #2b8a3e;">
                    <label style="font-size: 0.8rem; font-weight: bold; color: #2b8a3e; text-transform: uppercase;">Giá Phòng Tự Động (VNĐ/Đêm)</label>
                    <div style="display: flex; align-items: center; gap: 15px; margin-top: 5px;">
        
                        <!-- Input ẩn chứa giá trị thực gửi về Server -->
                        <input asp-for="GiaPhong" id="GiaPhong" type="hidden" />
        
                        <!-- Chữ hiển thị giá tiền to rõ ràng -->
                        <h2 id="giaPhongDisplay" style="font-family: var(--font-heading); color: #2b8a3e; margin: 0; font-size: 1.8rem;">
                            @(Model.GiaPhong > 0 ? Model.GiaPhong.ToString("N0") + " ₫" : "0 ₫")
                        </h2>

                        <span style="background: rgba(43,138,62,0.1); color: #2b8a3e; font-size: 0.75rem; padding: 5px 12px; border-radius: 20px; font-weight: bold;">
                            <i class="fas fa-calculator"></i> Tự động tính toán
                        </span>
                    </div>
                </div>

        </div> <!-- Kết thúc Grid -->

        <!-- NÚT BẤM -->
        <div class="form-actions">
            <button type="button" class="btn-outline" onclick="closeAdminModal()">
                Hủy Bỏ
            </button>
            <button type="submit" class="btn-gold">
                <i class="fas fa-save" style="margin-right: 5px;"></i> LƯU DỮ LIỆU
            </button>
        </div>
    </form>
</div>
