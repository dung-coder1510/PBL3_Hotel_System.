<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Hotel VIP</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/base.css" />
    <link rel="stylesheet" href="~/css/Reset.css" />
    <link href="~/css/sidebar.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <partial name="_NotificationPartial" />

    <div class="dashboard-wrapper">
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="/" class="logo-text">Hotel VIP</a>
            </div>

            <div class="user-box">
                @{
                        var name = User.Identity.Name ?? "Admin";
                    }
                <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(name)&background=d4af37&color=fff" class="user-avatar">
                <h3>@name</h3>
                <p>Quản Trị Viên</p>
            </div>

            <nav class="nav-menu">
                @* Dùng C# để kiểm tra Active Menu *@
                <li>
                    <a asp-controller="Admin" asp-action="index"
                           class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Index" ? "active" : "")">
                        <i class="fas fa-home"></i> Trang chủ
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="QuanLyTaiKhoan"
                           class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Accounts" ? "active" : "")">
                        <i class="fa-solid fa-circle-user"></i> Quản Lý Tài Khoản
                    </a>
                </li>

                <li>
                    <a asp-controller="Admin" asp-action="QuanLyNhanVien"
                           class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Staff" ? "active" : "")">
                        <i class="fa-solid fa-person"></i> Quản Lý Nhân Viên
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="QuanLyLuong"
                           class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Salary" ? "active" : "")">
                        <i class="fa-solid fa-table"></i> Quản Lý Bảng Lương
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="QuanLyHeThong"
                           class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "System" ? "active" : "")">
                        <i class="fa-solid fa-hotel"></i> Quản Lý Hệ Thống
                    </a>
                </li>

                <li>
                    <a asp-controller="Profile" asp-action="Index"
                           class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Profile" ? "active" : "")">
                        <i class="fas fa-user-cog"></i> Thông tin cá nhân
                    </a>
                </li>
            </nav>

            <div style="padding: 20px; border-top: 1px solid rgba(255,255,255,0.1);">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" style="background:none; border:none; color:#ff4d4d; cursor:pointer; display:flex; align-items:center; gap:10px;">
                        <i class="fas fa-sign-out-alt"></i> Đăng xuất
                    </button>
                </form>
            </div>
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>
    <!-- KHUNG MODAL RỖNG ĐỂ HỨNG FORM AJAX CHO ADMIN -->
    <div id="adminModalOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(3px);">
        <div id="adminModalContent" style="background: #fff; width: 900px; max-width: 90%; padding: 30px; border-radius: 15px; position: relative; box-shadow: 0 20px 50px rgba(0,0,0,0.3);">
            <!-- Nội dung từ _AccountFormPartial sẽ đổ vào đây -->
        </div>
    </div>
    <script src="~/js/RoomResult.js"></script>
    @RenderSection("Scripts", required: false)
    <script>
            // BƯỚC 1: Lắng nghe sự kiện đổi tài khoản giữa các tab
            window.addEventListener('storage', function(event) {
                if (event.key === 'authStatus') {
                    // Nếu có một tab khác báo là đã đổi trạng thái, tải lại trang này ngay lập tức
                    console.log("Phát hiện thay đổi xác thực từ tab khác. Đang nạp lại trang...");
                    window.location.reload();
                }
            });

            // BƯỚC 2: Gắn lệnh báo hiệu vào nút Đăng xuất
            document.addEventListener("DOMContentLoaded", function () {
                const logoutBtn = document.querySelector('a[href*="Logout"], button[type="submit"]:has(i.fa-sign-out-alt)'); // Tìm nút đăng xuất
                if (logoutBtn) {
                    logoutBtn.addEventListener('click', function() {
                        // Đánh dấu thời điểm đăng xuất (số ngẫu nhiên để ép nó thay đổi)
                        localStorage.setItem('authStatus', 'logged_out_' + Date.now());
                    });
                }
        
                // Hoặc gắn vào trang Login khi đăng nhập thành công
                if (window.location.pathname.includes("Success") || window.location.pathname === "/") {
                     localStorage.setItem('authStatus', 'logged_in_' + Date.now());
                }
            });
    </script>
