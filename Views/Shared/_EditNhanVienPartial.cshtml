@model PBL3_Hotel_System.ViewModels.AdminNhanVienEditViewModel

<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #eee; padding-bottom: 20px; margin-bottom: 25px;">
    <div>
        <h3 style="font-family: var(--font-heading); color: var(--secondary-color); margin: 0; display: flex; align-items: center; gap: 10px;">
            <i class="fas fa-id-card-alt text-gold"></i> Cập Nhật Hồ Sơ Nhân Sự
        </h3>
        <p style="color: gray; font-size: 0.85rem; margin: 5px 0 0 0;">Tài khoản liên kết: <strong>@Model.Username</strong></p>
    </div>
    <button type="button" onclick="closeAdminModal()" style="background: none; border: none; font-size: 1.5rem; color: #888; cursor: pointer;">&times;</button>
</div>

<form asp-controller="Admin" asp-action="UpdateNhanVienInfo" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserID" />

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 25px; margin-bottom: 30px;">
        
        <!-- CỘT 1: THÔNG TIN CÁ NHÂN -->
        <div class="input-box full-width" style="grid-column: 1 / -1;">
            <label style="font-size: 0.75rem; color: #888; text-transform: uppercase; font-weight: bold; margin-bottom: 5px; display: block;">
                Họ và tên nhân viên <i class="fas fa-pen text-gold" style="margin-left: 5px; font-size: 0.6rem;"></i>
            </label>
            <input asp-for="HoTen" class="inline-input watch-change" placeholder="Nhập họ tên mới..."
                   style="width: 100%; border: none; border-bottom: 1px dashed #ccc; padding: 10px 0; font-family: var(--font-heading); font-size: 1.3rem; color: var(--secondary-color); font-weight: 600; outline: none; transition: 0.3s;"
                   onfocus="this.style.borderBottom='2px solid var(--primary-color)'" onblur="this.style.borderBottom='1px dashed #ccc'" />
        </div>

        <div class="input-box">
            <label style="font-size: 0.75rem; color: #888; text-transform: uppercase; font-weight: bold; margin-bottom: 5px; display: block;">
                Số điện thoại <i class="fas fa-pen text-gold" style="margin-left: 5px; font-size: 0.6rem;"></i>
            </label>
            <input asp-for="SoDienThoai" class="inline-input watch-change"
                   style="width: 100%; border: none; border-bottom: 1px dashed #ccc; padding: 10px 0; font-family: var(--font-body); font-size: 1rem; color: var(--secondary-color); outline: none; transition: 0.3s;"
                   onfocus="this.style.borderBottom='2px solid var(--primary-color)'" onblur="this.style.borderBottom='1px dashed #ccc'" />
        </div>

        <div class="input-box">
            <label style="font-size: 0.75rem; color: #888; text-transform: uppercase; font-weight: bold; margin-bottom: 5px; display: block;">
                Địa chỉ liên hệ <i class="fas fa-pen text-gold" style="margin-left: 5px; font-size: 0.6rem;"></i>
            </label>
            <input asp-for="DiaChi" class="inline-input watch-change"
                   style="width: 100%; border: none; border-bottom: 1px dashed #ccc; padding: 10px 0; font-family: var(--font-body); font-size: 1rem; color: var(--secondary-color); outline: none; transition: 0.3s;"
                   onfocus="this.style.borderBottom='2px solid var(--primary-color)'" onblur="this.style.borderBottom='1px dashed #ccc'" />
        </div>

        <!-- CỘT 2: THÔNG TIN NGHIỆP VỤ (Vùng xám nhạt) -->
        <div class="input-box full-width" style="grid-column: 1 / -1; background: #f8f9fa; padding: 20px; border-radius: 12px; border: 1px solid #eee; display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
    
            <!-- Bên trái: Chức vụ -->
            <div>
                <label style="font-size: 0.8rem; color: var(--secondary-color); font-weight: bold; margin-bottom: 8px; display: block;">
                    <i class="fas fa-briefcase text-gold"></i> Chức vụ hiện tại
                </label>
                <select asp-for="ChucVu" class="form-control" style="padding: 12px; border-radius: 8px; border: 1px solid #ced4da; width: 100%; outline: none; font-weight: 500; color: var(--secondary-color); background: #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.02);">
                    <option value="">-- Giữ nguyên --</option>
                    <option value="Lễ tân">Lễ tân</option>
                    <option value="Buồng phòng">Buồng phòng</option>
                    <option value="Bảo vệ">Bảo vệ</option>
                    <option value="Kế toán">Kế toán</option>
                </select>
            </div>
    
            <!-- Bên phải: Bảng thống kê lương (Readonly) -->
            <div style="background: #fff; padding: 15px 20px; border-radius: 8px; border-left: 4px solid #2b8a3e; box-shadow: 0 4px 10px rgba(0,0,0,0.04);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px dashed #eee;">
                    <label style="font-size: 0.8rem; color: var(--secondary-color); font-weight: bold; margin: 0;">
                        <i class="fas fa-money-check-alt" style="color: #2b8a3e; margin-right: 5px;"></i> Tạm tính lương
                    </label>
                    <!-- Badge ghi chú 400k/ca -->
                    <span style="background: #fff3cd; color: #f39c12; font-size: 0.7rem; padding: 4px 10px; border-radius: 20px; font-weight: 800; letter-spacing: 0.5px;">
                        400.000đ / CA
                    </span>
                </div>
        
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: #888; font-size: 0.85rem; font-weight: 600;">Lương tuần này:</span>
                        <strong style="color: var(--secondary-color); font-size: 1rem;">@Model.LuongTuanNay</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: #888; font-size: 0.85rem; font-weight: 600;">Lương tháng này:</span>
                        <strong style="color: #2b8a3e; font-size: 1.2rem;">@Model.LuongThangNay</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Nút Submit -->
    <div style="display: flex; gap: 15px; justify-content: flex-end; padding-top: 20px; border-top: 1px solid #eaeaea;">
        <button type="button" class="btn" style="background: transparent; color: #666; border: 1px solid #ccc; padding: 10px 25px; border-radius: 30px; font-weight: 600;" onclick="closeAdminModal()">HỦY BỎ</button>
        <button type="submit" class="btn" style="background: var(--primary-color); color: white; padding: 10px 30px; border-radius: 30px; font-weight: 700;">LƯU HỒ SƠ</button>
    </div>

    <script src="~/js/RoomResult.js"></script>
</form>