@{
    Layout = "_NVDashboardLayout"; // Kéo Layout của NV vào
    ViewData["Title"] = "Tổng Quan Nhân Viên";
    ViewData["ActiveMenu"] = "Index"; // Kích hoạt nút sáng ở menu
}

@section Styles {
    <style>
        /* CSS DÀNH RIÊNG CHO CÁC CARD TÁC VỤ CỦA NHÂN VIÊN */
        .action-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 30px;
        }

        .uc-card {
            background: #fff;
            padding: 40px 30px;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-light);
            text-align: center;
            transition: all 0.3s ease;
            border-bottom: 5px solid transparent;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

            .uc-card:hover {
                transform: translateY(-10px);
                box-shadow: var(--shadow-dark);
                border-bottom-color: var(--primary-color);
            }

        .icon-circle {
            width: 80px;
            height: 80px;
            background: rgba(212, 175, 55, 0.1);
            color: var(--primary-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 20px;
            transition: 0.3s;
        }

        .uc-card:hover .icon-circle {
            background: var(--primary-color);
            color: white;
            transform: scale(1.1) rotate(5deg);
        }

        .uc-card h3 {
            font-family: var(--font-heading);
            color: var(--secondary-color);
            margin-bottom: 15px;
            font-size: 1.5rem;
        }

        .uc-card p {
            color: var(--text-light);
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 25px;
            flex-grow: 1; /* Đẩy nút xuống dưới cùng cho đều nhau */
        }

        .btn-gold-action {
            display: inline-block;
            background: var(--bg-body);
            color: var(--secondary-color);
            padding: 10px 30px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.85rem;
            letter-spacing: 1px;
            transition: 0.3s;
            border: 1px solid #ddd;
        }

        .uc-card:hover .btn-gold-action {
            background: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
        }

    .tab-btn { transition: 0.3s; border-radius: 6px; }
    .tab-btn:hover { background: #f4f6f8; color: var(--primary-color) !important; }
    .tab-btn.active { color: var(--primary-color) !important; border-bottom: 2px solid var(--primary-color); }

    </style>
}

<!-- TIÊU ĐỀ TRANG -->
<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem;">
    <div>
        <h2 style="font-family: var(--font-heading); font-size: 2.2rem; color: var(--secondary-color);">Tác Vụ Nhân Viên</h2>
        <p style="color: var(--text-light)">Quản lý và vận hành các hoạt động của khách sạn.</p>
    </div>
    <div style="background: white; padding: 10px 20px; border-radius: 30px; box-shadow: var(--shadow-light); display: flex; align-items: center; gap: 10px;">
        <i class="far fa-user-circle text-gold" style="color: var(--primary-color); font-size: 1.2rem;"></i>
        <span>Xin chào, <strong>@(User.Identity.Name ?? "Bạn")</strong></span>
    </div>
</div>


<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 30px;">
    
    <!-- LỊCH LÀM VIỆC TUẦN NÀY -->
    <div style="background: white; padding: 25px; border-radius: 12px; box-shadow: var(--shadow-light);">
    <h4 style="color: var(--secondary-color); margin-bottom: 20px; font-family: var(--font-heading);">
        <i class="fas fa-calendar-alt text-gold"></i> Lịch làm việc tuần này
    </h4>

    <!-- THANH TAB CHỌN THỨ -->
    <div style="display: flex; gap: 5px; margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 10px;">
        @for (int i = 2; i <= 8; i++)
        {
            var dayName = (i == 8) ? "CN" : "Thứ " + i;
            // Tạo ID động để JS dễ bắt
            <button class="tab-btn" onclick="filterShiftByDay('@dayName')" style="padding: 8px 15px; border:none; background:none; cursor:pointer; font-weight:600; color:#888;">
                @dayName
            </button>
        }
    </div>

    <!-- KHU VỰC HIỂN THỊ CA LÀM (Được filter bởi JS) -->
    <div id="shift-display-area" style="min-height: 150px;">
        <!-- Dữ liệu sẽ được nạp vào đây -->
    </div>
</div>

    <!-- BIỂU ĐỒ TRẠNG THÁI PHÒNG -->
    <div style="background: white; padding: 25px; border-radius: 12px; box-shadow: var(--shadow-light);">
        <h4 style="color: var(--secondary-color); margin-bottom: 20px;"><i class="fas fa-chart-pie text-gold"></i> Trạng thái phòng hiện tại</h4>
        <div style="height: 200px;">
            <canvas id="miniRoomChart"></canvas>
        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // --- 1. BIỂU ĐỒ TRẠNG THÁI PHÒNG (Doughnut) ---
        const roomData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.RoomStatusData));
        console.log("Dữ liệu phòng:", roomData); // Bấm F12 xem có dữ liệu không

        const ctx = document.getElementById('miniRoomChart');
        if (!ctx) {
            console.error("Không tìm thấy canvas miniRoomChart!");
            return;
        }

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Sẵn sàng', 'Đang ở', 'Dọn dẹp', 'Bảo trì'],
                datasets: [{
                    // LỖI Ở ĐÂY: Dữ liệu đang là object {Count: 3}, phải lấy .Count ra
                    data: roomData.map(item => item.Count), 
                    backgroundColor: ['#d4edda', '#2c3e50', '#d4af37', '#f8d7da'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { position: 'right' } 
                }
            }
        });

        // --- 2. XỬ LÝ TAB LỊCH LÀM VIỆC ---
        const weeklyShifts = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.WeeklyShifts));
        
        // Gán sự kiện click cho các tab
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                // Xóa active cũ
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                // Active tab mới
                this.classList.add('active');
                
                // Gọi hàm lọc
                filterShiftByDay(this.innerText.trim());
            });
        });

        // Hàm lọc nội bộ
        window.filterShiftByDay = function(dayName) {
            const area = document.getElementById('shift-display-area');
            area.innerHTML = ''; 

            const filtered = weeklyShifts.filter(s => {
                const date = new Date(s.NgayLam);
                const days = ["CN", "Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5", "Thứ 6", "Thứ 7"];
                return days[date.getDay()] === dayName;
            });

            if (filtered.length > 0) {
                filtered.forEach(shift => {
                    area.innerHTML += `
                        <div class="shift-card" style="margin-bottom:10px; padding: 12px; border-left: 4px solid #d4af37; background: #fffdf8;">
                            <strong style="display:block;">${shift.CaLam.TenCa}</strong>
                            <small style="color: #888;"><i class="far fa-clock"></i> ${shift.CaLam.GioBatDau} - ${shift.CaLam.GioKetThuc}</small>
                        </div>`;
                });
            } else {
                area.innerHTML = `<div style="text-align:center; padding:20px; color:#ccc;">Không có lịch làm!</div>`;
            }
        }
        
        // Mặc định load thứ 2
        filterShiftByDay('Thứ 2');
    });
</script>