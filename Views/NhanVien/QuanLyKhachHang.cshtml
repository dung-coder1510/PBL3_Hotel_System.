@model IEnumerable<PBL3_Hotel_System.Models.Booking>
@{
    Layout = "_NVDashboardLayout"; // Gọi Layout chuẩn của Nhân viên
    ViewData["Title"] = "Quản Lý Khách Hàng";
    ViewData["ActiveMenu"] = "QuanLyKhachHang"; // Làm sáng menu bên Sidebar
}

@section Styles {
    <style>
        /* 1. HAI THẺ CHỨC NĂNG (CHECK-IN / CHECK-OUT) */
        .feature-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 2.5rem;
        }

        .feature-card {
            background: #fff;
            padding: 30px;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-light);
            transition: all 0.3s ease;
            border-top: 4px solid var(--primary-color);
            display: flex;
            flex-direction: column;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-dark);
        }

        .feature-card h4 {
            font-family: var(--font-heading);
            color: var(--secondary-color);
            font-size: 1.3rem;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .feature-card h4 i { color: var(--primary-color); font-size: 1.5rem; }
        .feature-card p { color: var(--text-light); font-size: 0.9rem; margin-bottom: 25px; flex-grow: 1; line-height: 1.6; }

        .btn-outline-gold {
            background: transparent;
            color: var(--primary-color);
            border: 1px solid var(--primary-color);
            padding: 10px;
            width: 100%;
            border-radius: 6px;
            font-weight: 600;
            text-align: center;
            transition: 0.3s;
            cursor: pointer;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
        }

        .btn-outline-gold:hover {
            background: var(--primary-color);
            color: white;
        }

        /* 2. BẢNG DỮ LIỆU LUXURY */
        .content-card {
            background: #fff;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-light);
            padding: 25px 30px;
        }

        .card-header-title {
            font-family: var(--font-heading);
            color: var(--secondary-color);
            font-size: 1.4rem;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid #f0f0f0;
        }
        /* ĐÂY LÀ CHIẾC HỘP TRẮNG CHỨA NỘI DUNG BIÊN LAI */
    #bookingModalContent {
        background: #fff;
        width: 850px;
        max-width: 95%;
        padding: 30px;
        border-radius: 16px;
        position: relative;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);

        /* ========================================= */
        /* GIẢI PHÁP CHỐNG TRÀN: THÊM THANH CUỘN      */
        /* ========================================= */
        max-height: 85vh;    /* Cao tối đa bằng 85% chiều cao màn hình */
        overflow-y: auto;    /* Tự động hiện thanh cuộn dọc nếu nội dung dài */
        overflow-x: hidden;  /* Cấm cuộn ngang */
    }

    /* Mẹo: Làm thanh cuộn mỏng và sang trọng hơn cho giống Hotel Luxury */
    #bookingModalContent::-webkit-scrollbar {
        width: 6px;
    }
    #bookingModalContent::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }
    #bookingModalContent::-webkit-scrollbar-thumb {
        background: var(--primary-color); /* Màu vàng Gold của bạn */
        border-radius: 10px;
    }
    #bookingModalContent::-webkit-scrollbar-thumb:hover {
        background: var(--primary-hover);
    }


        .table-wrapper { overflow-x: auto; }
        .table-luxury { width: 100%; border-collapse: collapse; text-align: left; }
        .table-luxury th { padding: 15px; background: #f8f9fa; color: #888; font-size: 0.8rem; text-transform: uppercase; border-bottom: 2px solid #eee; }
        .table-luxury td { padding: 15px; border-bottom: 1px solid #f5f5f5; vertical-align: middle; color: var(--text-main); }
        .table-luxury tbody tr:hover { background-color: #fdfcf8; }

        /* Thông tin khách hàng */
        .customer-info strong { color: var(--secondary-color); font-size: 1rem; display: block; margin-bottom: 3px; }
        .customer-info small { color: #888; font-size: 0.85rem; display: flex; align-items: center; gap: 5px; }

       
        /* Nút Xem chi tiết */
        .btn-action-view {
            background: #f4f6f8; color: var(--secondary-color); padding: 6px 15px;
            border-radius: 6px; text-decoration: none; font-size: 0.85rem; font-weight: 500;
            transition: 0.3s; display: inline-flex; align-items: center; gap: 5px;
        }
        .btn-action-view:hover { background: var(--secondary-color); color: white; }

        /* Nút phân trang Luxury */
        .btn-page { width: 35px; height: 35px; border-radius: 50%; border: 1px solid #ddd; background: #fff; color: #555; font-weight: bold; cursor: pointer; transition: 0.3s; display: flex; align-items: center; justify-content: center; }
        .btn-page:hover { border-color: var(--primary-color); color: var(--primary-color); }
        .btn-page.active { background: var(--primary-color); color: white; border-color: var(--primary-color); box-shadow: 0 4px 10px rgba(212, 175, 55, 0.3); }

        /* Toolbar */
        .filter-toolbar { display: flex; gap: 15px; background: #fff; padding: 20px; border-radius: 12px; margin-bottom: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border-top: 4px solid var(--primary-color); }
        .filter-item { flex: 1; display: flex; flex-direction: column; gap: 5px; }
        .filter-item label { font-size: 0.8rem; color: #888; font-weight: bold; text-transform: uppercase; }
        .filter-input { padding: 10px 15px; border: 1px solid #ddd; border-radius: 8px; outline: none; transition: 0.3s; }
        .filter-input:focus { border-color: var(--primary-color); }
    </style>
}

<!-- TIÊU ĐỀ TRANG -->
<div class="header-text" style="margin-bottom: 2.5rem;">
    <h2 style="font-family: var(--font-heading); font-size: 2.2rem; color: var(--secondary-color);">Quản Lý Khách Hàng</h2>
    <p style="color: var(--text-light)">Quy trình Check-in / Check-out và hỗ trợ khách lưu trú.</p>
</div>

<!-- 2. BẢNG DỮ LIỆU ĐẶT PHÒNG THỰC TẾ -->
<div class="content-card">
    <h3 class="card-header-title">Danh sách chờ xử lý</h3>
    
    <!-- THANH CÔNG CỤ TÌM KIẾM (AJAX) -->
    <form id="filterForm" class="filter-toolbar" onsubmit="event.preventDefault(); loadTableData(1);">
        <div class="filter-item">
            <label>Tìm khách hàng</label>
            <input type="text" id="searchString" class="filter-input" placeholder="Tên hoặc SĐT...">
        </div>
        <div class="filter-item">
            <label>Trạng thái</label>
            <select id="statusFilter" class="filter-input" onchange="loadTableData(1)">
                <option value="All">-- Tất cả --</option>
                <option value="ChoXacNhan">Chờ xác nhận</option>
                <option value="DaXacNhan">Đã duyệt (Sắp đến)</option>
                <option value="DangO">Đang lưu trú</option>
                <option value="YeuCauTraPhong">Yêu cầu trả phòng</option>
                <option value="DaHoanThanh">Hoàn thành</option>
            </select>
        </div>
        <div class="filter-item">
            <label>Ngày Check-in</label>
            <input type="date" id="dateFilter" class="filter-input" onchange="loadTableData(1)">
        </div>
        <div class="filter-item" style="justify-content: flex-end; flex: 0.5;">
            <button type="submit" class="btn-action" style="background: var(--primary-color); color: white; border: none; padding: 12px; border-radius: 8px; width: 100%;">
                <i class="fas fa-search"></i> LỌC
            </button>
        </div>
    </form>

    <div class="table-wrapper" id="table-container">
        <div style="text-align: center; padding: 50px;">
            <i class="fas fa-spinner fa-spin fa-2x text-gold"></i>
            <p style="color: #888; margin-top: 10px;">Đang tải dữ liệu...</p>
        </div>
    </div>

    </div>
</div>
<!-- KHUNG MODAL RỖNG -->
<div id="bookingModalOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(5px);">
    <div id="bookingModalContent" style="background: #fff; width: 850px; max-width: 95%; padding: 30px; border-radius: 12px; position: relative; box-shadow: 0 15px 40px rgba(0,0,0,0.2);">
        <!-- Nội dung sẽ đổ vào đây -->
    </div>
</div>

@section Scripts {
    <script>
        // Hàm load dữ liệu bằng AJAX Fetch
        function loadTableData(page) {
            const search = document.getElementById("searchString").value;
            const status = document.getElementById("statusFilter").value;
            const date = document.getElementById("dateFilter").value;

            const container = document.getElementById("table-container");
            container.innerHTML = '<div style="text-align: center; padding: 50px;"><i class="fas fa-spinner fa-spin fa-2x" style="color: #d4af37;"></i><p>Đang tải...</p></div>';

            const url = `/NhanVien/FilterBookings?search=${encodeURIComponent(search)}&status=${status}&date=${date}&page=${page}`;

            fetch(url)
                .then(res => res.text())
                .then(html => {
                    container.innerHTML = html;
                })
                .catch(err => {
                    console.error(err);
                    container.innerHTML = '<div style="color: red; text-align: center; padding: 30px;">Lỗi kết nối.</div>';
                });
        }

        // Tự động load trang 1 khi vừa vào màn hình
        document.addEventListener("DOMContentLoaded", function () {
            loadTableData(1);
        });
        
        // Cải tiến UX: Gõ xong tự động tìm kiếm (Debounce)
        let typingTimer;
        document.getElementById("searchString").addEventListener("keyup", function() {
            clearTimeout(typingTimer);
            typingTimer = setTimeout(() => { loadTableData(1); }, 500); // Ngừng gõ 0.5s thì tự load
        });
    </script>
}
